pipeline {
    agent any

    environment {
        DEPLOY_DIR = "${WORKSPACE}/python-app-deploy"
    }

    stages {
        stage('Build') {
            steps {
                dir('python-flask-app') {
                    echo 'Creating virtual environment and installing dependencies...'
                    sh '''
                        python3 -m venv .venv
                        .venv/bin/python -m pip install --upgrade pip
                        .venv/bin/python -m pip install -r requirements.txt
                        .venv/bin/python -m pip install flake8
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('python-flask-app') {
                    echo 'Running unit tests...'
                    sh '.venv/bin/python -m unittest discover -s . -p "test_*.py"'
                }
            }
        }

        stage('Code Quality') {
            steps {
                dir('python-flask-app') {
                    echo 'Running code quality checks...'
                    sh '.venv/bin/flake8 app.py test_app.py'
                }
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying application...'
                sh '''
                    mkdir -p "$DEPLOY_DIR"

                    if [ -f "$DEPLOY_DIR/app.pid" ]; then
                        OLD_PID=$(cat "$DEPLOY_DIR/app.pid")
                        if kill -0 "$OLD_PID" 2>/dev/null; then
                            kill "$OLD_PID" || true
                        fi
                    fi

                    cp "$WORKSPACE/python-flask-app/app.py" "$DEPLOY_DIR/"
                    cp "$WORKSPACE/python-flask-app/requirements.txt" "$DEPLOY_DIR/"
                '''
            }
        }

        stage('Run Application') {
            steps {
                echo 'Starting the deployed Flask application...'
                sh '''
                    PYTHON="$WORKSPACE/python-flask-app/.venv/bin/python"

                    JENKINS_NODE_COOKIE=dontKillMe nohup "$PYTHON" \
                        "$DEPLOY_DIR/app.py" \
                        > "$DEPLOY_DIR/app.log" 2>&1 &

                    echo $! > "$DEPLOY_DIR/app.pid"
                '''
            }
        }

        stage('Test Application') {
            steps {
                echo 'Checking the deployed application over HTTP...'
                sh '''
                    PYTHON="$WORKSPACE/python-flask-app/.venv/bin/python"

                    for i in $(seq 1 15); do
                        if "$PYTHON" -c "import urllib.request; r=urllib.request.urlopen('http://127.0.0.1:5000/', timeout=2); assert r.status == 200; assert r.read().decode() == 'Hello, Jenkins Multi-Stage Pipeline!'" 2>/dev/null; then
                            echo "Application HTTP test passed!"
                            exit 0
                        fi
                        sleep 1
                    done

                    echo "Application failed to respond correctly."
                    cat "$DEPLOY_DIR/app.log"
                    exit 1
                '''
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the console output and application logs.'
        }
    }
}
